# Port for local development. Hosting services set PORT themselves — leave API_PORT out there.
API_PORT=5050
# Set to production on the live server (secure cookies, HTTPS headers, serves the built website).
NODE_ENV=development
# The live address, e.g. https://sidhagora.onrender.com — used in WhatsApp/Facebook share previews.
SITE_URL=
# Local MongoDB or MongoDB Atlas connection string.
# If MongoDB is not reachable, the server falls back to a local JSON file (server/data/words.json).
MONGO_URI=mongodb://127.0.0.1:27017/village_language
# Long random string used to sign login tokens. Change it in production.
JWT_SECRET=change-me-to-a-long-random-string
# Optional persistent directory for validated CMS image uploads (use a persistent disk in production).
UPLOAD_DIR=

# Free key for real festival dates (Google Calendar API). Leave empty to show months only.
GOOGLE_API_KEY=
